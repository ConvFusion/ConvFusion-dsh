{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "outDir": "lib/client",
    "rootDir": "src/client",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["react"],
    "noEmit": false
  },
  "include": ["src/client"],
  "exclude": ["node_modules", "lib"]
}
